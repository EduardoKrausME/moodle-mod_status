{{!
    @template mod_status/dashboard

    Example context (json):
    {
        *Example context (json):*
    }
}}
<div class="mod-status-toolbar">
    <div>
        <strong>{{#str}}dashboard, mod_status{{/str}}</strong>
        <span class="text-muted">{{#str}}totalstudents, mod_status, {{total}}{{/str}}</span>
    </div>
    <small class="text-muted">{{#str}}updatedat, mod_status{{/str}} {{updatedat}}</small>
</div>
<div class="mod-status-grid">
    {{#states}}
        <section class="mod-status-card" data-statekey="{{key}}">
            <header class="mod-status-card-header">
                <h3>{{label}}</h3>
                <span class="badge rounded-pill bg-secondary">{{count}}</span>
            </header>
            <div class="mod-status-user-list">
                {{#users}}
                    <div class="mod-status-user">
                        <span class="mod-status-avatar" aria-hidden="true">{{initials}}</span>
                        <span>{{fullname}}</span>
                    </div>
                {{/users}}
                {{^hasusers}}
                    <div class="mod-status-empty">{{#str}}nobody, mod_status{{/str}}</div>
                {{/hasusers}}
            </div>
        </section>
    {{/states}}
    <section class="mod-status-card mod-status-card-notset">
        <header class="mod-status-card-header">
            <h3>{{#str}}notset, mod_status{{/str}}</h3>
            <span class="badge rounded-pill bg-secondary">{{notsetcount}}</span>
        </header>
        <div class="mod-status-user-list">
            {{#notset}}
                <div class="mod-status-user">
                    <span class="mod-status-avatar" aria-hidden="true">{{initials}}</span>
                    <span>{{fullname}}</span>
                </div>
            {{/notset}}
            {{^hasnotset}}
                <div class="mod-status-empty">{{#str}}nobody, mod_status{{/str}}</div>
            {{/hasnotset}}
        </div>
    </section>
</div>
